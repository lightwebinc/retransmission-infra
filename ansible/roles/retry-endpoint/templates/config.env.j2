# retry-endpoint environment configuration
# Managed by Ansible — do not edit manually

MC_IFACE={{ mc_iface }}
LISTEN_PORT={{ listen_port }}
NACK_PORT={{ nack_port }}
{# Tee ingest (loopback frame mirror from a co-resident proxy/listener
   -retry-tee). Rendered only when set — default render is byte-identical, and
   an older binary ignores unknown env keys. retry_mc_join_enabled=false is
   tee-only ingest (no multicast join, no wildcard data-port bind); the binary
   fails closed unless the tee address is also set. #}
{% if retry_tee_listen | default('') %}
TEE_LISTEN={{ retry_tee_listen }}
{% endif %}
{% if not (retry_mc_join_enabled | default(true) | bool) %}
MC_JOIN_ENABLED=false
{% endif %}
EGRESS_IFACE={{ egress_iface }}
EGRESS_PORT={{ egress_port }}
SHARD_BITS={{ shard_bits }}
MC_SCOPE={{ mc_scope }}
MC_GROUP_ID={{ mc_group_id }}
# Addressing model: ssm (FF3x, first-class) | asm (FF0x, lab fallback). retry
# joins the groups to cache frames; under SSM it source-specific-joins the
# static publisher list, and its retransmits bind a routable per-node source.
SOURCE_MODE={{ source_mode | default('asm') }}
{% if bind_source | default('') %}
BIND_SOURCE={{ bind_source }}
{% endif %}
{% if ssm_publishers_static | default('') %}
SSM_PUBLISHERS_STATIC={{ ssm_publishers_static }}
{% endif %}
# BRC-132 subtree data caching: join GroupSubtreeDataAnnounce (0xFFFB) and serve
# subtree NACKs. Required whenever a downstream shard-listener runs
# -subtree-data-enabled and relies on NACK repair. Under SSM the join is
# source-specific and needs the bootstrap roster below — without it the binary
# falls back to an ASM join, which the SSM range ignores (silent no-op).
SUBTREE_DATA_ENABLED={{ 'true' if subtree_data_enabled | default(false) else 'false' }}
{% if ssm_bootstrap_subtree_announce | default('') %}
SSM_BOOTSTRAP_SUBTREE_ANNOUNCE={{ ssm_bootstrap_subtree_announce }}
{% endif %}
CACHE_BACKEND={{ cache_backend }}
REDIS_ADDR={{ redis_addr }}
{% if aerospike_hosts %}
AEROSPIKE_HOSTS={{ aerospike_hosts }}
AEROSPIKE_NAMESPACE={{ aerospike_namespace }}
AEROSPIKE_SET={{ aerospike_set }}
{% endif %}
CACHE_DIAL_TIMEOUT={{ cache_dial_timeout }}
CACHE_OP_TIMEOUT={{ cache_op_timeout }}
CACHE_TTL={{ cache_ttl }}
CACHE_TTL_TX={{ cache_ttl_tx }}
CACHE_TTL_BLOCK={{ cache_ttl_block }}
CACHE_TTL_SUBTREE={{ cache_ttl_subtree }}
CACHE_TTL_BEEF={{ cache_ttl_beef | default('60s') }}
BEEF_ENABLED={{ 'true' if beef_enabled | default(false) else 'false' }}
BEEF_SHARD_BITS={{ beef_shard_bits | default(0) }}
CACHE_TTL_ANCHOR={{ cache_ttl_anchor }}
CACHE_MAX_KEYS={{ cache_max_keys }}
DEDUP_WINDOW={{ dedup_window }}
RL_IP_RATE={{ rl_ip_rate }}
RL_IP_BURST={{ rl_ip_burst }}
RL_CHAIN_RATE={{ rl_chain_rate }}
RL_CHAIN_WINDOW={{ rl_chain_window }}
RL_SEQUENCE_MAX={{ rl_sequence_max }}
RL_SEQUENCE_WINDOW={{ rl_sequence_window }}
RL_GROUP_RATE={{ rl_group_rate }}
RL_GROUP_BURST={{ rl_group_burst }}
NACK_WORKERS={{ num_workers }}
METRICS_ADDR={{ metrics_addr }}
OTLP_ENDPOINT={{ otlp_endpoint }}
OTLP_INTERVAL={{ otlp_interval }}
LOG_FORMAT={{ log_format }}
LOG_LEVEL={{ log_level }}
TRACE_SAMPLING={{ trace_sampling }}
DRAIN_TIMEOUT={{ drain_timeout }}
INSTANCE_ID={{ instance_id }}
DEBUG={{ 'true' if retry_debug else 'false' }}

NACK_ADDR={{ nack_addr }}

# Beacon configuration (BRC-126)
BEACON_ENABLED={{ 'true' if beacon_enabled else 'false' }}
BEACON_TIER={{ beacon_tier }}
BEACON_PREFERENCE={{ beacon_preference }}
BEACON_INTERVAL={{ beacon_interval }}
BEACON_SCOPE={{ beacon_scope }}
BEACON_FLAGS_UNICAST={{ 'true' if beacon_flags_unicast else 'false' }}
BEACON_FLAGS_MULTICAST={{ 'true' if beacon_flags_multicast else 'false' }}
BEACON_FLAGS_DRAINING={{ 'true' if beacon_flags_draining else 'false' }}
SUPPRESS_ACK={{ 'true' if suppress_ack else 'false' }}
SUPPRESS_MISS={{ 'true' if suppress_miss else 'false' }}
RL_THROTTLE_RESPONSE={{ 'true' if rl_throttle_response else 'false' }}

# BRC-126 cross-domain NACK relay (one-hop). Off by default, matching the
# binary: with proxy_enabled false the endpoint serves only its own cache.
# When a downstream domain cannot see the frames it missed (its listener's
# egress dropped them, so the local cache never held them), the relay forwards
# a cache-miss NACK to an upstream endpoint and re-caches the answer. Every
# tuning default below is the binary's own, so rendering them is a no-op until
# an operator overrides one.
PROXY_ENABLED={{ 'true' if proxy_enabled | default(false) else 'false' }}
UPSTREAM_RETRY_ENDPOINTS={{ upstream_retry_endpoints | default('') }}
PROXY_WORKERS={{ proxy_workers | default(4) }}
PROXY_QUEUE={{ proxy_queue | default(1024) }}
PROXY_TIMEOUT={{ proxy_timeout | default('300ms') }}
PROXY_MAX_ENDPOINTS={{ proxy_max_endpoints | default(0) }}
PROXY_DEDUP_WINDOW={{ proxy_dedup_window | default('60s') }}
