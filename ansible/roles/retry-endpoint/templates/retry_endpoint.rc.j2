#!/bin/sh
#
# PROVIDE: retry_endpoint
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# Managed by Ansible — do not edit manually
#
# Add the following to /etc/rc.conf to enable:
#   retry_endpoint_enable="YES"

. /etc/rc.subr

name="retry_endpoint"
rcvar="retry_endpoint_enable"
desc="Bitcoin Retry Endpoint"

load_rc_config "${name}"

: ${retry_endpoint_enable:="NO"}
: ${retry_endpoint_user:="{{ retry_user }}"}
: ${retry_endpoint_group:="{{ retry_group }}"}
: ${retry_endpoint_config:="/usr/local/etc/retry-endpoint.conf"}
: ${retry_endpoint_logfile:="/var/log/retry_endpoint.log"}
: ${retry_endpoint_pidfile:="/var/run/retry_endpoint.pid"}

pidfile="${retry_endpoint_pidfile}"
command="{{ retry_bin_dir }}/retry-endpoint"
command_args=""

start_precmd="retry_endpoint_prestart"
start_cmd="retry_endpoint_start"
stop_cmd="retry_endpoint_stop"
status_cmd="retry_endpoint_status"

retry_endpoint_prestart()
{
    # Load environment from config file
    if [ -f "${retry_endpoint_config}" ]; then
        . "${retry_endpoint_config}"
    fi
    export MULTICAST_IF LISTEN_PORT NACK_PORT
    export EGRESS_IFACE EGRESS_PORT SHARD_BITS MC_SCOPE MC_GROUP_ID
    export CACHE_BACKEND REDIS_ADDR CACHE_TTL CACHE_MAX_KEYS
    export CACHE_TTL_TX CACHE_TTL_BLOCK CACHE_TTL_SUBTREE CACHE_TTL_ANCHOR
    export RL_IP_RATE RL_IP_BURST RL_SENDER_RATE RL_SENDER_BURST
    export RL_SENDER_WINDOW RL_SEQUENCE_MAX RL_SEQUENCE_WINDOW
    export RL_GLOBAL_RATE RL_GLOBAL_BURST
    export NUM_WORKERS METRICS_ADDR OTLP_ENDPOINT OTLP_INTERVAL
    export DRAIN_TIMEOUT INSTANCE_ID DEBUG NACK_ADDR
    export BEACON_ENABLED BEACON_TIER BEACON_PREFERENCE BEACON_INTERVAL
    export BEACON_SCOPE BEACON_FLAGS_UNICAST BEACON_FLAGS_MULTICAST
    export BEACON_FLAGS_DRAINING SUPPRESS_ACK SUPPRESS_MISS
}

retry_endpoint_start()
{
    retry_endpoint_prestart
    /usr/sbin/daemon -f -p "${pidfile}" -u "${retry_endpoint_user}" \
        ${command} >> "${retry_endpoint_logfile}" 2>&1
    echo "retry_endpoint started."
}

retry_endpoint_stop()
{
    if [ -f "${pidfile}" ]; then
        kill -TERM $(cat "${pidfile}") && rm -f "${pidfile}"
        echo "retry_endpoint stopped."
    else
        echo "retry_endpoint is not running."
    fi
}

retry_endpoint_status()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat "${pidfile}") 2>/dev/null; then
        echo "retry_endpoint is running (pid $(cat ${pidfile}))."
    else
        echo "retry_endpoint is not running."
        return 1
    fi
}

run_rc_command "$1"
